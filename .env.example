# Copy this file to `.env.local` and fill in the values.
# See README.md → "Connecting the CMS" for where to find them.

# From sanity.io/manage → your project → Project ID
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# The public URL of the site. Used for canonical URLs, sitemap.xml and social previews.
NEXT_PUBLIC_SITE_URL=https://example.com

# Optional. A random string you also paste into the Sanity webhook that makes
# published edits appear on the site immediately. See README.md → "Instant updates".
SANITY_REVALIDATE_SECRET=
